# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# TypeScript incremental build state
*.tsbuildinfo

# Test and coverage output
coverage/

# Local caches and temp files
.cache/
.tmp/
*.tmp
.npm-cache/

# Python bytecode from the bundled py/xl_build DSL
__pycache__/
*.pyc

# Local test-run layout dump
/vitest-layout.txt

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editor and tool state
.idea/
.vscode/
*.swp

# Build outputs, regenerated by `npm run build` (see README.md). A fresh
# clone must build before a profile junction can load lib/.
lib/

# Local machine artifacts: ACL-recovery skill output, decoded session
# journals, and the literal "%SystemDrive%" tree a broken command once
# created in this workspace. None of these belong in the repository.
.acl-recovery/
.session-*.journal.jsonl
%SystemDrive%/
_analysis/
